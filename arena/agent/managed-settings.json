{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "test ! -f /tmp/bsa-prompt || exit 2" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 /opt/bsa/deny_hook.py managed" }
        ]
      }
    ]
  }
}
